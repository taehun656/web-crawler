      "method": "POST",
      "key_params": {
        "url": "pub/getReq_view",
        "mode": "getReq_view",
        "reqId": "encB64(DOCID) — base64 인코딩 후 앞뒤 절반을 뒤바꾼다",
        "fromWhere": "list",
        "view_yn": "Y"
      },
      "field_mapping": {
        "조회수": "<strong>조회수</strong>N</li>",
        "등록일": "<strong>등록일</strong>YYYY-MM-DD</li>",
